#!/usr/bin/env python
import rospy
from sensor_msgs.msg import LaserScan
from sensor_msgs.msg import Joy
from geometry_msgs.msg import Twist
import math
import numpy as np

inf = float("inf")


def deg_range_to_index(check_min, check_max, angle_min, angle_max , step):
    min_index = 6279 * (math.radians(check_min) - angle_min) / (angle_max - angle_min) 
    max_index = 6279 * (math.radians(check_max) - angle_min) / (angle_max - angle_min)
         
    return min_index, max_index 
    

#def callback_sweep(data):

 #   idx1, idx2 = deg_range_to_index(-20, 20, data.angle_min, data.angle_max, data.angle_increment)
  #  sweep_vals = data.ranges[int(idx1):int(idx2)]
   # distance = np.array(list(filter(lambda x: x != inf , sweep_vals))).sum()
    
    
def callback_sweep(data):
    global distance
    distance = data
    
       

def callback_joy(data):
    twist = Twist()
    if data.buttons[0]==1 and data.buttons[3]==0 and data.buttons[4]==0:
        twist.angular.z = 0
        obstacle = False
        idx1, idx2 = deg_range_to_index(-20, 20, distance.angle_min, distance.angle_max, distance.angle_increment)
        for i in range(int(idx1), int(idx2)):
            if  distance.ranges[i] < 0.40:
                obstacle = True
        if obstacle == True:
            twist.linear.x = 1.25
        else:
            twist.linear.x = 0
    elif data.buttons[0]==0 and data.buttons[3]==1 and data.buttons[4]==0:
        twist.angular.z = -10
        twist.linear.x = 1.20    
    elif data.buttons[0]==0 and data.buttons[3]==0 and data.buttons[4]==1:
        twist.angular.z = 10
        twist.linear.x = 1.20
    else:
        twist.angular.z = 10*data.axes[0]
        if data.buttons[6] == 1 and data.buttons[7] == 0:
    	    twist.linear.x = (5 * (data.axes[4] + 1) - 10)/4
        elif data.buttons[6] == 0 and data.buttons[7] == 1:
            twist.linear.x = -5 * (data.axes[4]+ 1) + 10
        elif data.buttons[6] == 1 and data.buttons[7] == 1:
	    twist.linear.x = 5 * (data.axes[4] + 1) - 10
        elif data.buttons[6] == 0 and data.buttons[7] == 0:
	    twist.linear.x = (-5 * (data.axes[4]+ 1) + 10)/4
   
	
    pub.publish(twist)
        
   
def start():
    global pub
    
    
    #Publicando en el topico turtle1/cmd_vel para mover a la tortuga
    pub = rospy.Publisher('jetsoncar_instructions', Twist, queue_size=10)
    rospy.Subscriber("scan", LaserScan, callback_sweep)
    rospy.Subscriber("joy", Joy, callback_joy)
    rospy.init_node('jetson_rutines', anonymous = True)
       
        	  
if __name__ == '__main__':
    try:
        start()
    except rospy.ROSInterruptException:
        pass
