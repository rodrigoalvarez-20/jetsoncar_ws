  #  sweep_vals = data.ranges[int(idx1):int(idx2)]
   # distance = np.array(list(filter(lambda x: x != inf , sweep_vals))).sum()
    
    
def callback_sweep(data):
    global distance
    distance = data
    
       

def callback_joy(data):
    global joy
    joy = data
        
   
def start():
    global pub
    twist = Twist()
    
    
    #Publicando en el topico turtle1/cmd_vel para mover a la tortuga
    pub = rospy.Publisher('jetsoncar_instructions', Twist, queue_size=10)
    rospy.Subscriber("scan", LaserScan, callback_sweep)
    rospy.Subscriber("joy", Joy, callback_joy)
    rospy.init_node('jetson_rutines', anonymous = True)
    while not rospy.is_shutdown():
        if joy.buttons[0]==1 and joy.buttons[3]==0 and joy.buttons[4]==0:
            twist.angular.z = 0
            obstacle = False
            idx1, idx2 = deg_range_to_index(-20, 20, distance.angle_min, distance.angle_max, distance.angle_increment)
            for i in range(int(idx1), int(idx2)):
                if  distance.ranges[i] < 0.40:
                    obstacle = True
                if obstacle == True:
                    twist.linear.x = 1.25
                else:
                    twist.linear.x = 0
        elif joy.buttons[0]==0 and joy.buttons[3]==1 and joy.buttons[4]==0:
            twist.angular.z = -10
            twist.linear.x = 1.20    
        elif joy.buttons[0]==0 and joy.buttons[3]==0 and joy.buttons[4]==1:
            twist.angular.z = 10
            twist.linear.x = 1.20
        else:
            twist.angular.z = 10*data.axes[0]
            if joy.buttons[6] == 1 and joy.buttons[7] == 0:
    	        twist.linear.x = (5 * (data.axes[4] + 1) - 10)/4
            elif joy.buttons[6] == 0 and joy.buttons[7] == 1:
                twist.linear.x = -5 * (joy.axes[4]+ 1) + 10
            elif joy.buttons[6] == 1 and joy.buttons[7] == 1:
	        twist.linear.x = 5 * (joy.axes[4] + 1) - 10
            elif joy.buttons[6] == 0 and joy.buttons[7] == 0:
	        twist.linear.x = (-5 * (joy.axes[4]+ 1) + 10)/4
   
	
        pub.publish(twist)
       
        	  
if __name__ == '__main__':
    try:
        start()
    except rospy.ROSInterruptException:
        pass
