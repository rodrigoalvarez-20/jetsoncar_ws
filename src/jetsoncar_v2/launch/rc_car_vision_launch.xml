<launch>
    <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py"/>
    <node pkg="jetsoncar_v2" exec="rc_car_vanilla" name="rc_car_control" namespace="jetsoncar" />
    <node pkg="realsense2_camera" exec="realsense2_camera_node" name="camera" namespace="camera">
        <param name="rgb_camera.profile" value="848x480x30" />
        <param name="rgb_camera.format" value="RGB8" />
        <param name="reconnect_timeout" value="5.0" />
    </node>
    <node pkg="jetsoncar_v2" exec="server_image" name="stream_subscriber" namespace="jetsoncar">
        <param name="streaming_host" value="192.168.1.14" />
        <param name="streaming_port" value="8089" />
    </node>
</launch>